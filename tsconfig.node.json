{
  "compilerOptions": {
    // "module": "CommonJS", // Use CommonJS for Node.js compatibility
    "moduleResolution": "bundler", // Use Node.js module resolution
    "target": "ESNext", // Target a modern ECMAScript version
    "esModuleInterop": true, // Enable ES module interop
    "jsx": "react-jsx",
    "skipLibCheck": true, // Skip library checks to speed up compilation
    "allowSyntheticDefaultImports": true, // Allow synthetic default imports
    "outDir": "dist", // Output directory for compiled files
    "rootDir": ".", // Root directory for source files
    "types": ["node"] // Include Node.js types
  },
  "include": ["vite.config.mts", "src/**/*.ts", "src/**/*.tsx"], // Include necessary files
  "exclude": ["node_modules"] // Exclude node_modules
}
